          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.test('pedido criado como PENDENTE', function () { pm.expect(body.statusPedido).to.eql('PENDENTE'); });",
                  "pm.environment.set('pedidoId', body.pedidoId);",
                  "pm.environment.set('qrCodePix', body.qrCodePix || '');",
                  "// referencia da cobranca do gateway fake = ultimo segmento de urlPagamento",
                  "var ref = (body.urlPagamento || '').split('/checkout/')[1] || '';",
                  "pm.environment.set('referenciaGateway', ref);",
                  "pm.test('referencia do gateway capturada', function () { pm.expect(ref).to.not.be.empty; });"
                ]
              }
            }
