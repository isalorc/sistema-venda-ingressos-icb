        {
          "name": "Admin · Cadastrar evento",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A data do evento precisa estar no futuro (@Future). Recalcula para hoje + 90 dias.",
                  "var d = new Date(Date.now() + 90 * 24 * 60 * 60 * 1000);",
                  "pm.environment.set('dataHoraEvento', d.toISOString().slice(0, 19));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.test('retorna o id do evento', function () { pm.expect(body.id).to.be.a('number'); });",
                  "pm.environment.set('eventoId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Congresso de Louvor 2026\",\n  \"descricao\": \"Conferencia anual de louvor e adoracao da ICB\",\n  \"dataHora\": \"{{dataHoraEvento}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/eventos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "eventos"]
            },
            "description": "RF-20. Requer `Authorization: Bearer {{adminToken}}` (rode o Login antes)."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Congresso de Louvor 2026\",\n  \"descricao\": \"Conferencia anual de louvor e adoracao da ICB\",\n  \"dataHora\": \"2026-12-20T19:00:00\"\n}" },
                "url": { "raw": "{{baseUrl}}/api/admin/eventos", "host": ["{{baseUrl}}"], "path": ["api", "admin", "eventos"] }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
