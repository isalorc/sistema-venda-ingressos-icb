        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USUARIO {\n        LONG id PK\n        VARCHAR nome\n        VARCHAR email\n        VARCHAR telefone\n    }\n\n    EVENTO {\n        LONG id PK\n        VARCHAR nome\n        TEXT descricao\n        DATETIME data_hora\n    }\n\n    LOTE {\n        LONG id PK\n        LONG evento_id FK\n        VARCHAR nome \&quot;Ex: Lote 1, VIP\&quot;\n        DECIMAL preco\n        INT quantidade_total\n        INT quantidade_disponivel\n    }\n\n    INGRESSO {\n        LONG id PK\n        LONG evento_id FK\n        LONG lote_id FK\n        LONG pedido_id FK \&quot;NULL se não comprado\&quot;\n        VARCHAR codigo_qr\n        VARCHAR status \&quot;DISPONIVEL, RESERVADO, VENDIDO, UTILIZADO\&quot;\n    }\n\n    PEDIDO {\n        LONG id PK\n        LONG usuario_id FK\n        DATETIME data_pedido\n        VARCHAR status \&quot;PENDENTE, PAGO, CANCELADO\&quot;\n        DECIMAL valor_total\n    }\n\n    PAGAMENTO {\n        LONG id PK\n        LONG pedido_id FK\n        DATETIME data_pagamento\n        DECIMAL valor\n        VARCHAR metodo\n        VARCHAR status\n    }\n\n    USUARIO ||--o{ PEDIDO : \&quot;realiza\&quot;\n    PEDIDO ||--o{ INGRESSO : \&quot;contém\&quot;\n    PEDIDO ||--o{ PAGAMENTO : \&quot;tem\&quot;\n    EVENTO ||--o{ LOTE : \&quot;possui\&quot;\n    LOTE ||--o{ INGRESSO : \&quot;gera\&quot;\n    EVENTO ||--o{ INGRESSO : \&quot;contém\&quot;\n```&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Wco2pa26ox8pHMmXKhuT-1">
