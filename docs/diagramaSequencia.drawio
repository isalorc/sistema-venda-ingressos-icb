        <mxCell id="m5" value="5. valida participantes (1 a 5 nomes, nenhum em branco)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;align=left;spacingLeft=6;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="342" as="sourcePoint" /><mxPoint x="790" y="366" as="targetPoint" /><Array as="points"><mxPoint x="830" y="342" /><mxPoint x="830" y="366" /></Array><mxPoint as="offset" x="0" y="0" /></mxGeometry></mxCell>
