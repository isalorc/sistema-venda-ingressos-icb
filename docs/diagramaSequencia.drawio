        <mxCell id="v_pg" value="GatewayPagamentoPort&lt;br&gt;(Adapter Out - API)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=60;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="1140" y="40" width="180" height="1010" as="geometry" /></mxCell>
        <mxCell id="m1" value="1. POST /api/compras {loteId, participantes[1..5], metodoPagamento} + Bearer token" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="150" as="sourcePoint" /><mxPoint x="350" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2. valida o token (papel = CLIENTE) e extrai usuarioId" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;align=left;spacingLeft=6;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="194" as="sourcePoint" /><mxPoint x="350" y="218" as="targetPoint" /><Array as="points"><mxPoint x="390" y="194" /><mxPoint x="390" y="218" /></Array><mxPoint as="offset" x="0" y="0" /></mxGeometry></mxCell>
        <mxCell id="n_401" value="Token ausente ou inválido: 401.&lt;br&gt;Token de admin: 403." style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="410" y="204" width="200" height="40" as="geometry" /></mxCell>
