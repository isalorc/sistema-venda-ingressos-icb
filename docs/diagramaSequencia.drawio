        <mxCell id="g2" value="[estoque suficiente]" style="text;html=1;fontSize=11;fontStyle=2;" parent="1" vertex="1"><mxGeometry x="56" y="704" width="260" height="22" as="geometry" /></mxCell>
        <mxCell id="n_fim" value="Depois da compra: a reserva vale 15 minutos. O webhook do gateway confirma o pagamento (pedido PAGO, ingressos VENDIDOS com um QR cada) ou recusa; se nada chegar, o job de expiração (a cada 1 min) marca o pedido como EXPIRADO e devolve os ingressos ao lote." style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="50" y="1060" width="1240" height="60" as="geometry" /></mxCell>
